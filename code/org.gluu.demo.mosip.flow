//This flow is dedicated exclusively for the MOSIP demo. Requisites:
// - Casa acct linking plugin
// - Casa cert-authn plugin
// - agama-pw and agama-inji-wallet projects deployed

Flow org.gluu.demo.mosip
    Basepath ""
    
Repeat 3 times max
    obj = Trigger io.jans.casa.authn.acctlinking
        Override templates "blb4x/acctlinking.ftlh" "cust-login-acctlinking.ftlh"
        
    When obj.aborted is null    //User took usual Casa authentication, terminate as such
        Finish obj
    
    Match obj.data."_abort" to
        ""
            pid = obj.data.providerId
            Log "User selected identity provider" pid
            
            //Launch the flow again, this time preselecting the given identity provider
            obj = Trigger io.jans.casa.authn.acctlinking pid null
            Finish obj
            
        "cert"
            Log "Smart card/User cert option selected"
            obj = Trigger io.jans.casa.cert.standaloneOneStepAuthn
            When obj.success is true
                Finish obj
            
        "recover"
            Log "Recover password selected"
            obj = Trigger org.gluu.agama.pw.reset
            Finish obj

Finish obj
