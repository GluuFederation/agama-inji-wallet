// Main
Flow com.gluu.agama.inji.main
     Basepath ""
     Configs conf
     Inputs uidRef
// Main orchestrator flow for Inji wallet verification
Log "@info Start executing Agama-Inji wallet flow...  with input param %" uidRef
actualUidRef = null
When uidRef is not null
     When uidRef.flowQname is not null
          Log "@info Input is a Map with metadata, ignoring and setting uidRef to null"
          actualUidRef = null
     Otherwise
          // Input is a simple string
          Log "@info Input is a simple string, using as uidRef: %" uidRef
          actualUidRef = uidRef
// Feedback message
feedback = {}
//  Max repeate
Repeat 3 times max
     // Create an instance of Agma-inji verification Service
     agamaInjiVerificationService = Call org.gluu.agama.inji.AgamaInjiVerificationService#getInstance conf
     // Send an Authorization Request to Inji verify endpoint
     verificationResult = Call agamaInjiVerificationService createVpVerificationRequest 