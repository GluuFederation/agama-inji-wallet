// This flow is helping flow for plugin. it will trigger com.gluu.agama.main 
Flow io.jans.casa.inji.link
     Basepath ""
     Inputs uidRef
Log "@info Casa Inji linking flow started for user: %" uidRef
// Call the main verification flow
result = Trigger com.gluu.agama.inji.main uidRef
// Always finish with the uidRef for successful linking
// Even if the main flow returns something else, we return the uidRef
Log "@info Casa Inji linking completed, returning uidRef"
it_sjxzw = {success:true, data: { userId: uidRef}}
Finish it_sjxzw